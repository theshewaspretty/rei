# 이 파일을 .env 로 복사한 뒤 값을 채우세요. .env 는 커밋하지 마세요.

# 관제 화면 로그인 비밀번호 (12자 이상). 값에 $ 가 있으면 $$ 로 적어야 합니다 (compose 가 변수로 해석함).
ADMIN_PASSWORD=

# 에이전트 등록 토큰 (24자 이상의 무작위 값). 에이전트를 설치하는 사람만 알아야 합니다.
#   Linux:      openssl rand -base64 32
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
ENROLL_TOKEN=

# 호스트에 여는 포트
PUBLISH_PORT=8443

# TLS 방식
#   selfsigned : 서버가 인증서를 직접 만들고(/data/tls), 에이전트는 그 지문으로 서버를 확인합니다. 기본값.
#   files      : 사내 CA 등에서 발급받은 인증서 사용. TLS_CERT_FILE / TLS_KEY_FILE 필요.
#   off        : 서버는 평문 HTTP. 앞단의 리버스 프록시가 HTTPS 를 끝낼 때만 쓰세요.
TLS_MODE=selfsigned

# selfsigned 인증서에 넣을 서버의 이름·IP (쉼표로 구분). 브라우저 주소와 맞아야 이름 경고가 줄어듭니다.
# 인증서를 만든 뒤에 바꾸려면 볼륨의 /data/tls 를 지우고 다시 시작해야 하며, 지문이 바뀌므로 에이전트도 다시 설치해야 합니다.
TLS_HOSTS=

# TLS_MODE=files 일 때 컨테이너 안에서의 경로 (docker-compose.yml 의 ./certs 볼륨 주석을 푸세요)
TLS_CERT_FILE=
TLS_KEY_FILE=

# 통신 흐름 기록 보존 기간(일)
RETENTION_DAYS=30

# 이미지 태그와 화면에 표시되는 버전
VERSION=1.0.0
